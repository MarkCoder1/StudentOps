# StudentOps server-side env — copy to .env.local and fill
# NEVER commit .env.local
# Apify token must be server-side only (no NEXT_PUBLIC_)
APIFY_API_TOKEN=your_apify_token_here
# Optional: only if ScholarshipFinder actor ID is known
# SCHOLARSHIP_FINDER_ACTOR_ID=your-actor-id
# Groq AI provider (server-side only, never NEXT_PUBLIC_)
GROQ_API_KEY=
