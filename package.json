{
  "name": "studentops-server-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 5.1 source adapters — server-side only",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 & dns-sd -P StudentOps _http._tcp . 3000 $(ipconfig getifaddr en0) localhost",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "ingest": "node --env-file=.env.local --import tsx/esm src/server/opportunities/ingest.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
